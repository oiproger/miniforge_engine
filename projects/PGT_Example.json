      "data": "{\"version\":1,\"title\":\"NPC Dialogue\",\"quests\":[{\"id\":\"quest_intro\",\"title\":\"Поговорить со старожилом\",\"description\":\"Узнать новости в посёлке.\",\"defaultStatus\":\"inactive\"}],\"nodes\":[{\"id\":\"d-start\",\"type\":\"start\",\"x\":60,\"y\":120,\"nextNodeId\":\"d-line-1\"},{\"id\":\"d-line-1\",\"type\":\"line\",\"x\":290,\"y\":100,\"speaker\":\"Сосед Петрович\",\"text\":\"Здорово! Выручишь с одним делом?\",\"choices\":[{\"id\":\"c-1\",\"text\":\"Конечно, рассказывай\",\"nextNodeId\":\"d-act-1\"},{\"id\":\"c-2\",\"text\":\"Позже зайду\",\"nextNodeId\":\"d-end\"}]},{\"id\":\"d-act-1\",\"type\":\"action\",\"x\":536,\"y\":101,\"actionKind\":\"setQuest\",\"actionKey\":\"quest_intro\",\"actionValue\":\"active\",\"nextNodeId\":\"dlg-ef39249d-7e15-4b35-bc96-a87a85a41ad4\"},{\"id\":\"d-end\",\"type\":\"end\",\"x\":944,\"y\":789},{\"id\":\"dlg-ef39249d-7e15-4b35-bc96-a87a85a41ad4\",\"type\":\"line\",\"x\":720,\"y\":233,\"speaker\":\"Сосед Петрович\",\"text\":\"Спасибо, мужик!\",\"choices\":[],\"nextNodeId\":\"dlg-69ba5da2-bfda-40b9-b1aa-7d2bcfdef450\"},{\"id\":\"dlg-69ba5da2-bfda-40b9-b1aa-7d2bcfdef450\",\"type\":\"line\",\"x\":718,\"y\":314,\"speaker\":\"Сосед Петрович\",\"text\":\"Я короче чего прошу-то\",\"choices\":[],\"nextNodeId\":\"dlg-38e04b2b-c124-4041-b568-9b5c57d1bea9\"},{\"id\":\"dlg-38e04b2b-c124-4041-b568-9b5c57d1bea9\",\"type\":\"line\",\"x\":715,\"y\":393,\"speaker\":\"Сосед Петрович\",\"text\":\"Я оставил в гараже фунфырик, а ключ потерял. Сможешь пролезть туда и забрать?\",\"choices\":[{\"id\":\"ch-626fe370-8252-4e08-8b04-5711b1977bc2\",\"text\":\"Предлагаешь влезть? Меня же посадят\",\"nextNodeId\":\"dlg-f2f58beb-7686-433f-ab28-be2cdf9a1ff2\"},{\"id\":\"ch-93ae08cf-151e-4ade-a9e5-c03f5add554b\",\"text\":\"Хорошо\",\"nextNodeId\":\"dlg-f282658f-3eb1-446b-ad70-cbb090b947aa\"}]},{\"id\":\"dlg-f282658f-3eb1-446b-ad70-cbb090b947aa\",\"type\":\"line\",\"x\":717,\"y\":613,\"speaker\":\"Сосед Петрович\",\"text\":\"Мужик, ты просто легенда! Спасибо!\",\"choices\":[],\"nextNodeId\":\"d-end\"},{\"id\":\"dlg-f2f58beb-7686-433f-ab28-be2cdf9a1ff2\",\"type\":\"line\",\"x\":709,\"y\":518,\"speaker\":\"Сосед Петрович\",\"text\":\"Неее, всё норм будет, я ручаюсь\",\"choices\":[{\"id\":\"ch-2dedfb06-cd5a-4309-9889-bc5d797f7bc2\",\"text\":\"Хорошо\",\"nextNodeId\":\"dlg-f282658f-3eb1-446b-ad70-cbb090b947aa\"}]}]}",
      "properties": {}
    },
