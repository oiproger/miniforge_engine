{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "miniforge-editor",
  "productName": "Miniforge Engine",
  "version": "3.0.0",
  "identifier": "dev.miniforge.editor",
  "build": {
    "frontendDist": "../../../dist/editor",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Miniforge Engine",
        "width": 1440,
        "height": 920,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
