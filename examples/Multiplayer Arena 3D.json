    {
      "id": "script-mp-arena",
      "name": "MultiplayerArena.ts",
      "type": "script",
      "properties": {},
      "data": "export default function createBehavior(api) {\n  let hudEl = null\n  let pulses = 0\n  let hp = 100\n  let remoteHp = {}\n  let lastBanner = \"\"\n  let bannerTimer = 0\n  let spaceWasDown = false\n  let interactWasDown = false\n  let positioned = false\n\n  function updateHud() {\n    if (!hudEl) return\n    const st = api.net.getStats()\n    const role = st.isHost ? \"HOST\" : \"CLIENT\"\n    const roleColor = st.isHost ? \"#38bdf8\" : \"#f59e0b\"\n    const status = st.connected ? \"ONLINE\" : \"CONNECTING...\"\n    const peerHpStr = Object.entries(remoteHp).map(([id, val]) => \"Peer \" + id.slice(-4) + \": \" + val + \" HP\").join(\" · \")\n    hudEl.innerHTML = `\n      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:4px\">\n        <span style=\"background:${roleColor};color:#090d16;font-weight:700;padding:1px 6px;border-radius:4px;font-size:11px\">${role}</span>\n        <span style=\"color:#e2e8f0;font-weight:600\">${status}</span>\n        <span style=\"color:#94a3b8;margin-left:auto\">${st.rttMs} ms</span>\n      </div>\n      <div style=\"color:#cbd5e1;font-size:12px\">Players: <b style=\"color:#fff\">${st.peerCount}</b> · Your HP: <b style=\"color:#4ade80\">${hp}</b> · Pulses: <b style=\"color:#fbbf24\">${pulses}</b></div>\n      ${peerHpStr ? `<div style=\"color:#f59e0b;font-size:11px;margin-top:2px\">${peerHpStr}</div>` : \"\"}\n      <div style=\"color:#94a3b8;font-size:11px;margin-top:4px\">WASD Move · Space RPC · E (-10 HP sync)</div>\n      ${bannerTimer > 0 ? `<div style=\"margin-top:6px;padding:4px 6px;background:rgba(56,189,248,0.18);border:1px solid rgba(56,189,248,0.45);border-radius:4px;color:#7dd3fc;font-size:11px\">${lastBanner}</div>` : \"\"}\n    `\n  }\n\n  return {\n    onStart() {\n      api.net.setEntityVar(api.entity.id, \"hp\", hp)\n      api.net.setEntityVar(api.entity.id, \"score\", 0)\n      hudEl = document.createElement(\"div\")\n      hudEl.style.cssText = \"position:fixed;top:12px;right:12px;z-index:20;min-width:230px;padding:10px 12px;border-radius:8px;background:rgba(15,23,42,0.82);border:1px solid rgba(148,163,184,0.28);font-family:system-ui,sans-serif;font-size:12px;pointer-events:none;backdrop-filter:blur(6px);\"\n      document.body.appendChild(hudEl)\n\n      api.events.on(\"net.entityVarChanged\", (ev) => {\n        if (ev && ev.key === \"hp\" && ev.peerId && ev.peerId !== api.net.peerId()) {\n          remoteHp[ev.peerId] = ev.value\n          updateHud()\n        }\n      })\n      api.net.onRpc(\"arena:pulse\", (payload, sender) => {\n        pulses++\n        api.vars.score = pulses\n        api.net.setEntityVar(api.entity.id, \"score\", pulses)\n        const tag = sender === api.net.peerId() ? \"You\" : \"Peer \" + String(sender).slice(-4)\n        lastBanner = \"RPC Pulse from \" + tag + \"!\"\n        bannerTimer = 2.0\n        updateHud()\n      })\n      api.net.onPeerJoin((pid) => {\n        lastBanner = \"Player joined (\" + String(pid).slice(-4) + \")\"\n        bannerTimer = 2.5\n        updateHud()\n      })\n      api.net.onPeerLeave((pid) => {\n        delete remoteHp[pid]\n        lastBanner = \"Player left (\" + String(pid).slice(-4) + \")\"\n        bannerTimer = 2.5\n        updateHud()\n      })\n      updateHud()\n    },\n    onUpdate(dt) {\n      if (!positioned && api.net.getStats().connected) {\n        positioned = true\n        const x = api.net.isHost() ? -2.0 : 2.0\n        api.transform.position.set(x, 0.8, 2.0)\n      }\n      if (bannerTimer > 0) bannerTimer = Math.max(0, bannerTimer - dt)\n      const jumpDown = api.input.pressed(\"Jump\")\n      if (jumpDown && !spaceWasDown) {\n        const p = api.transform.position\n        api.net.rpc(\"arena:pulse\", { pos: [p.x, p.y, p.z] }, \"all\")\n      }\n      spaceWasDown = jumpDown\n      const interactDown = api.input.pressed(\"Interact\")\n      if (interactDown && !interactWasDown) {\n        hp = hp <= 10 ? 100 : hp - 10\n        api.net.setEntityVar(api.entity.id, \"hp\", hp)\n      }\n      interactWasDown = interactDown\n      updateHud()\n    },\n    onDestroy() {\n      if (hudEl && hudEl.parentNode) hudEl.parentNode.removeChild(hudEl)\n      hudEl = null\n    },\n  }\n}\n"
    }
  ],
