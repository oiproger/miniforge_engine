    {
      "id": "shader-water-demo",
      "name": "Water Waves.glsl",
      "type": "shader",
      "properties": {
        "vertex": "void mainVertex(inout vec3 position, inout vec3 normal) { position.y += sin(position.x * 3.0 + iTime * 2.0) * 0.08; }",
        "uniforms": {
          "u_speed": 1.2,
          "u_scale": 1,
          "u_color": "#38bdf8"
        }
      },
      "data": "uniform float u_speed;\nuniform float u_scale;\nuniform vec3 u_color;\nvoid mainImage(out vec4 color, vec2 uv) {\n  float spd = u_speed > 0.001 ? u_speed : 1.0;\n  float scl = max(2.0, (u_scale > 0.001 ? u_scale : 1.0) * 8.0);\n  vec3 base = length(u_color) > 0.01 ? u_color : vec3(0.22, 0.74, 0.97);\n  float w = sin(uv.x * scl + iTime * spd * 2.2) * cos(uv.y * scl * 0.8 - iTime * spd * 1.7);\n  color = vec4(mix(base * 0.45, base * 1.2, w * 0.5 + 0.5), 1.0);\n}"
    },
    {
      "id": "mat-water-demo",
      "name": "Water Shader Material",
      "type": "material",
      "data": "",
      "properties": {
        "color": "#38bdf8",
        "roughness": 0.2,
        "metalness": 0.1,
        "shader": "shader-water-demo"
      }
    },
    {
      "id": "script-shader-driver",
      "name": "ShaderUniformDriver.ts",
      "type": "script",
      "properties": {},
      "data": "export default function createBehavior(api) {\n  let t = 0\n  return {\n    onUpdate(dt) {\n      t += dt\n      api.materials.setShaderUniform(\"shader-water-demo\", \"u_speed\", 1.0 + Math.sin(t) * 0.5)\n    },\n  }\n}"
    }
