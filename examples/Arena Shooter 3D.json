    {
      "id": "script-shooter",
      "name": "ArenaShooter.ts",
      "type": "script",
      "data": "export default function (api: any) {\n  let hudEl: HTMLElement | null = null\n  let hitTimer = 0\n  let ammo = 12\n  let reloading = false\n  let onDown: ((e: MouseEvent) => void) | null = null\n  let onKey: ((e: KeyboardEvent) => void) | null = null\n\n  function playShotSound(hit: boolean) {\n    try {\n      const AC = (window as any).AudioContext || (window as any).webkitAudioContext\n      if (!AC) return\n      const ac = new AC()\n      const osc = ac.createOscillator()\n      const gain = ac.createGain()\n      osc.type = hit ? 'sawtooth' : 'triangle'\n      osc.frequency.setValueAtTime(hit ? 680 : 320, ac.currentTime)\n      osc.frequency.exponentialRampToValueAtTime(hit ? 140 : 90, ac.currentTime + 0.11)\n      gain.gain.setValueAtTime(0.16, ac.currentTime)\n      gain.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + 0.12)\n      osc.connect(gain)\n      gain.connect(ac.destination)\n      osc.start()\n      osc.stop(ac.currentTime + 0.13)\n    } catch {}\n  }\n\n  function updateHud() {\n    if (!hudEl) return\n    const am = hudEl.querySelector('#mf-ammo')\n    const hm = hudEl.querySelector('#mf-hit') as HTMLElement | null\n    if (am) am.textContent = reloading ? 'RELOADING...' : `AMMO: ${ammo} / 12  ·  LMB / F: Shoot  ·  R: Reload`\n    if (hm) hm.style.opacity = hitTimer > 0 ? '1' : '0'\n  }\n\n  function shoot() {\n    if (reloading) return\n    if (ammo <= 0) {\n      reload()\n      return\n    }\n    ammo--\n    api.camera.shake(0.14, 0.1)\n\n    const origin = api.camera.position || [0, 1.5, 0]\n    const dir = api.camera.forward || [0, 0, -1]\n\n    // Ray-sphere test against all entities tagged \"enemy\"\n    let bestId = ''\n    let bestDist = 40\n    const enemies = api.findByTag('enemy')\n    for (const id of enemies) {\n      const node = api.find(id)\n      if (!node || !node.active) continue\n      const ex = node.position.x - origin[0]\n      const ey = node.position.y - origin[1]\n      const ez = node.position.z - origin[2]\n      const proj = ex * dir[0] + ey * dir[1] + ez * dir[2]\n      if (proj <= 0.3 || proj > bestDist) continue\n      const px = ex - dir[0] * proj\n      const py = ey - dir[1] * proj\n      const pz = ez - dir[2] * proj\n      const perpSq = px * px + py * py + pz * pz\n      if (perpSq <= 0.65 * 0.65) {\n        bestDist = proj\n        bestId = id\n      }\n    }\n\n    if (bestId) {\n      playShotSound(true)\n      hitTimer = 0.18\n      api.vars.score = (Number(api.vars.score) || 0) + 100\n      const target = api.find(bestId)\n      if (target) {\n        // Respawn target drone at a new arena spot\n        const nx = (Math.random() - 0.5) * 8.5\n        const ny = 1.1 + Math.random() * 1.4\n        const nz = -4.5 + Math.random() * 2.5\n        target.position.set(nx, ny, nz)\n      }\n    } else {\n      playShotSound(false)\n    }\n    updateHud()\n  }\n\n  function reload() {\n    if (reloading) return\n    reloading = true\n    updateHud()\n    window.setTimeout(() => {\n      ammo = 12\n      reloading = false\n      updateHud()\n    }, 650)\n  }\n\n  return {\n    onStart() {\n      api.vars.score = 0\n      hudEl = api.ui.mount(\n        'shooter-hud',\n        `<div style=\"position:fixed;inset:0;pointer-events:none;font-family:system-ui,sans-serif;\">\n          <div style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:22px;height:22px;\">\n            <div style=\"position:absolute;left:10px;top:0;width:2px;height:7px;background:#fff;box-shadow:0 0 4px #000;\"></div>\n            <div style=\"position:absolute;left:10px;bottom:0;width:2px;height:7px;background:#fff;box-shadow:0 0 4px #000;\"></div>\n            <div style=\"position:absolute;top:10px;left:0;width:7px;height:2px;background:#fff;box-shadow:0 0 4px #000;\"></div>\n            <div style=\"position:absolute;top:10px;right:0;width:7px;height:2px;background:#fff;box-shadow:0 0 4px #000;\"></div>\n            <div id=\"mf-hit\" style=\"position:absolute;inset:-4px;border:2px solid #f59e0b;border-radius:99px;opacity:0;transition:opacity 0.08s;\"></div>\n          </div>\n          <div id=\"mf-ammo\" style=\"position:absolute;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(13,17,23,0.8);border:1px solid rgba(255,255,255,0.2);color:#fbbf24;padding:6px 14px;border-radius:8px;font-size:13px;font-weight:700;\">\n            AMMO: 12 / 12 · LMB / F: Shoot · R: Reload\n          </div>\n        </div>`,\n      )\n      onDown = (e: MouseEvent) => {\n        if (e.button === 0) shoot()\n      }\n      onKey = (e: KeyboardEvent) => {\n        if (e.code === 'KeyF' || e.code === 'Space') shoot()\n        if (e.code === 'KeyR') reload()\n      }\n      window.addEventListener('mousedown', onDown)\n      window.addEventListener('keydown', onKey)\n    },\n    onUpdate(dt: number) {\n      if (hitTimer > 0) {\n        hitTimer = Math.max(0, hitTimer - dt)\n        if (hitTimer === 0) updateHud()\n      }\n    },\n    onDestroy() {\n      if (onDown) window.removeEventListener('mousedown', onDown)\n      if (onKey) window.removeEventListener('keydown', onKey)\n      api.ui.unmount('shooter-hud')\n    },\n  }\n}\n",
      "properties": {}
    }
  ],
