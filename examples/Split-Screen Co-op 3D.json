    {
      "id": "script-coop-duo",
      "name": "LocalCoopController.ts",
      "type": "script",
      "properties": {},
      "data": "export default function createBehavior(api) {\n  const idx = Number(api.entity.properties?.playerIndex || 0)\n  const speed = 5.5\n  const baseY = 0.8\n  let vy = 0\n  let hudEl = null\n\n  return {\n    onStart() {\n      if (idx === 0) {\n        hudEl = document.createElement(\"div\")\n        hudEl.style.cssText = \"position:fixed;bottom:14px;left:50%;transform:translateX(-50%);z-index:20;padding:8px 14px;border-radius:8px;background:rgba(15,23,42,0.82);border:1px solid rgba(148,163,184,0.28);color:#e2e8f0;font-family:system-ui,sans-serif;font-size:12px;pointer-events:none;white-space:nowrap;\"\n        hudEl.innerHTML = \"<b style=\\\"color:#38bdf8\\\">P1 (Blue):</b> WASD + Space &nbsp;·&nbsp; <b style=\\\"color:#f59e0b\\\">P2 (Amber):</b> Arrow Keys + Enter &nbsp;·&nbsp; Gamepads 1–4\"\n        document.body.appendChild(hudEl)\n      }\n    },\n    onUpdate(dt) {\n      const [mx, mz] = api.net.getLocalPlayerMove(idx)\n      const p = api.transform.position\n      let nx = p.x\n      let ny = p.y\n      let nz = p.z\n      if (mx !== 0 || mz !== 0) {\n        nx = Math.max(-5.2, Math.min(5.2, nx + mx * speed * dt))\n        nz = Math.max(-5.2, Math.min(5.2, nz + mz * speed * dt))\n        api.transform.rotation.set(0, Math.atan2(mx, mz), 0)\n      }\n      if (ny <= baseY + 0.01 && api.net.getLocalPlayerAction(idx, \"jump\")) {\n        vy = 6.2\n      }\n      vy -= 18 * dt\n      ny += vy * dt\n      if (ny <= baseY) {\n        ny = baseY\n        vy = 0\n      }\n      p.set(nx, ny, nz)\n    },\n    onDestroy() {\n      if (hudEl && hudEl.parentNode) hudEl.parentNode.removeChild(hudEl)\n      hudEl = null\n    },\n  }\n}\n"
    },
