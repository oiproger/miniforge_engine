    {
      "id": "script-cam-follow",
      "name": "FollowCamera.ts",
      "type": "script",
      "data": "export default function (api: any) {\n  const offset = [0, 7.2, 8.2]\n  return {\n    onUpdate(dt: number) {\n      const p = api.player.position\n      if (!p) return\n      const tx = p[0] + offset[0]\n      const ty = p[1] + offset[1]\n      const tz = p[2] + offset[2]\n      const cur = api.camera.position || [tx, ty, tz]\n      const k = Math.min(1, dt * 7)\n      api.camera.setPosition([\n        cur[0] + (tx - cur[0]) * k,\n        cur[1] + (ty - cur[1]) * k,\n        cur[2] + (tz - cur[2]) * k,\n      ])\n      api.camera.lookAt([p[0], p[1] + 0.6, p[2]])\n    },\n  }\n}\n",
      "properties": {}
    }
  ],
