{
  "name": "miniforge-engine",
  "version": "3.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:runtime": "node packages/exporter/prepare.mjs",
    "dev": "pnpm prepare:runtime && vite --host 0.0.0.0",
    "build": "pnpm prepare:runtime && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node packages/graphics/device.mjs && vitest run",
    "test:gi": "vitest run tests/baked-gi.test.mjs",
    "test:e2e": "playwright test",
    "export:demo": "pnpm prepare:runtime && tsx packages/exporter/cli.ts",
    "desktop:editor": "node apps/editor-desktop/build.mjs editor",
    "desktop:game": "node apps/editor-desktop/build.mjs game",
    "build:site": "node scripts/build-site.mjs",
    "test:network": "node --experimental-strip-types --test tests/network-steam.check.mjs tests/steam-preview-bridge.check.mjs",
    "test:examples": "node --test tests/network-examples.check.mjs",
    "test:network-sync": "node --experimental-strip-types --test tests/network-sync-fields.check.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "fflate": "^0.8.2",
    "gl-matrix": "3.4.4",
    "littlejsengine": "1.30.1",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "assimpjs": "^0.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "tsx": "^4",
    "typescript-eslint": "^8",
    "vite": "^7.3.0",
    "vitest": "^4"
  }
}
