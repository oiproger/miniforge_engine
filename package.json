{
  "name": "miniforge-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prepare:runtime": "node packages/exporter/prepare.mjs",
    "dev": "pnpm prepare:runtime && vite --host 0.0.0.0",
    "build": "pnpm prepare:runtime && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "export:demo": "pnpm prepare:runtime && tsx packages/exporter/cli.ts",
    "desktop:editor": "node apps/editor-desktop/build.mjs editor",
    "desktop:game": "node apps/editor-desktop/build.mjs game"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "pnpm": "^12.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.184.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "tsx": "^4",
    "typescript-eslint": "^8",
    "vite": "^7.3.0",
    "vitest": "^4"
  }
}
